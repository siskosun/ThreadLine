{
  "name": "threadline-extension",
  "version": "0.8.1",
  "private": true,
  "description": "ThreadLine — temporary cross-conversation research workspace",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-version.mjs",
    "lint:syntax": "node scripts/check-syntax.mjs",
    "verify": "npm run lint:syntax && npm run check && npm run check:plan && npm test",
    "test:e2e": "python test/extension-e2e.py && python test/handoff-e2e.py && python test/ff-core-e2e.py && python test/evidence-e2e.py",
    "check:plan": "node ../scripts/check-plan.mjs",
    "build:argdown": "node scripts/build-argdown.mjs",
    "argdown:preview": "node scripts/argdown-preview.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@argdown/core": "2.0.1",
    "esbuild": "0.25.2"
  }
}
